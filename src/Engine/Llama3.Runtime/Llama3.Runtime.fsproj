    <Compile Include="Generation/Generation.fs" />
    <Compile Include="Llama3.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Llama3.Core\Llama3.Core.fsproj" />
    <ProjectReference Include="..\..\Backends\Llama3.Backend.CPU\Llama3.Backend.CPU.fsproj" />
    <ProjectReference Include="..\..\Backends\Llama3.Backend.CUDA\Llama3.Backend.CUDA.fsproj" />
  </ItemGroup>

</Project>
